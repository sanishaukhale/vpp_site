rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // System Settings: Anyone can read, only authenticated users can write
    match /settings/website {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Public Content: Only approved and published content is readable by the public
    match /{collection}/{docId} {
      allow read: if (collection in ['activities', 'projects', 'articles', 'team']) 
                     && resource.data.status == 'approved' 
                     && resource.data.isPublished == true;
    }
    
    // Admin access: Allow authenticated users to read/write all documents
    // Note: For production, you may want to refine this to only allow write if userProfile.role == "super_admin"
    match /{document=**} {
      allow read, write: if request.auth != null; 
    }
  }
}
